--- a/drivers/net/wireless/ath/ath9k/init.c
+++ b/drivers/net/wireless/ath/ath9k/init.c
@@ -169,6 +169,19 @@
  * as the FIFO on these devices can only accept sanely 2 requests.
  */
 
+#ifdef CONFIG_FUSIV
+/*
+ * On the Ikanos Fusiv PCI bridge, all registers read as zero after the chip
+ * initialization, and the second chip fails. Reading the bridge after each access,
+ * together with the pause in ar9002_hw_get_radiorev(), avoids it. The cause is unknown.
+ */
+void fusiv_pci_settle(void);
+#else
+static inline void fusiv_pci_settle(void)
+{
+}
+#endif
+
 static void ath9k_iowrite32(void *hw_priv, u32 val, u32 reg_offset)
 {
 	struct ath_hw *ah = hw_priv;
@@ -179,9 +192,12 @@
 		unsigned long flags;
 		spin_lock_irqsave(&sc->sc_serial_rw, flags);
 		iowrite32(val, sc->mem + reg_offset);
+		fusiv_pci_settle();
 		spin_unlock_irqrestore(&sc->sc_serial_rw, flags);
-	} else
+	} else {
 		iowrite32(val, sc->mem + reg_offset);
+		fusiv_pci_settle();
+	}
 }
 
 static unsigned int ath9k_ioread32(void *hw_priv, u32 reg_offset)
@@ -195,9 +211,12 @@
 		unsigned long flags;
 		spin_lock_irqsave(&sc->sc_serial_rw, flags);
 		val = ioread32(sc->mem + reg_offset);
+		fusiv_pci_settle();
 		spin_unlock_irqrestore(&sc->sc_serial_rw, flags);
-	} else
+	} else {
 		val = ioread32(sc->mem + reg_offset);
+		fusiv_pci_settle();
+	}
 	return val;
 }
 
@@ -217,9 +236,11 @@
 	u32 val;
 
 	val = ioread32(sc->mem + reg_offset);
+	fusiv_pci_settle();
 	val &= ~clr;
 	val |= set;
 	iowrite32(val, sc->mem + reg_offset);
+	fusiv_pci_settle();
 
 	return val;
 }
