// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "avm,fritzbox-7390", "ikanos,vx180";
	model = "AVM FRITZ!Box Fon WLAN 7390";

	aliases {
		serial0 = &uart2;
		led-boot = &led_power;
		led-failsafe = &led_power_red;
		led-running = &led_power;
		led-upgrade = &led_power_red;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* The numbers are those of AVM's hw156 configuration minus 16. */
	leds {
		compatible = "gpio-leds";

		led_power: led-0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;
			default-state = "keep";
		};

		led_power_red: led-1 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio1 9 GPIO_ACTIVE_LOW>;
		};

		led-2 {
			color = <LED_COLOR_ID_GREEN>;
			function = "internet";
			gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
		};

		/* Labelled "Festnetz" on the box. */
		led-3 {
			color = <LED_COLOR_ID_GREEN>;
			function = "phone";
			gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
		};

		led-4 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
		};

		led-5 {
			color = <LED_COLOR_ID_GREEN>;
			function = "info";
			gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
		};

		led-6 {
			color = <LED_COLOR_ID_RED>;
			function = "info";
			gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
		};
	};

	cpuintc: interrupt-controller {
		compatible = "mti,cpu-interrupt-controller";
		#address-cells = <0>;
		#interrupt-cells = <1>;
		interrupt-controller;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		ipc: interrupt-controller@19050000 {
			compatible = "ikanos,vx180-ipc";
			reg = <0x19050000 0x400>;
			#interrupt-cells = <1>;
			interrupt-controller;
			interrupt-parent = <&cpuintc>;
			interrupts = <2>;
		};

		/*
		 * GPIOs 16 to 31. GPIOs 0 to 15 stay without a driver, because /init
		 * drives the FPGA and the switch reset there through /dev/mem.
		 */
		gpio1: gpio@190b0000 {
			compatible = "ikanos,vx180-gpio";
			reg = <0x190b0000 0x8>;
			gpio-controller;
			#gpio-cells = <2>;
		};

		uart2: serial@190a0000 {
			compatible = "ns16450";
			reg = <0x190a0000 0x20>;
			reg-shift = <2>;
			clock-frequency = <166666666>;
			no-loopback-test;
			interrupt-parent = <&ipc>;
			interrupts = <29>;
		};

		ethernet@19110000 {
			compatible = "ikanos,fusiv-eth";
			reg = <0x19110000 0x1000>;
			interrupt-parent = <&ipc>;
			interrupts = <14>;
		};

		usb@19230000 {
			compatible = "generic-ehci";
			reg = <0x19230000 0x5c>;
			interrupt-parent = <&ipc>;
			interrupts = <35>;
		};

		usb@19240800 {
			compatible = "generic-ohci";
			reg = <0x19240800 0x5c>;
			interrupt-parent = <&ipc>;
			interrupts = <35>;
		};

		/*
		 * Mapped as ROM, so that Linux never sends a command to the chip.
		 * The urlader partition also holds secrets in its environment, so its
		 * content must stay out of logs. Only the calibration cells are used.
		 */
		flash@1f000000 {
			compatible = "mtd-rom";
			reg = <0x1f000000 0x1000000>;
			bank-width = <2>;

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				partition@0 {
					compatible = "nvmem-cells";
					label = "urlader";
					reg = <0x0 0x20000>;
					read-only;
					#address-cells = <1>;
					#size-cells = <1>;

					calibration_5ghz: calibration@985 {
						reg = <0x985 0x1000>;
					};

					calibration_2ghz: calibration@198a {
						reg = <0x198a 0x1000>;
					};
				};
			};
		};

		pci: pci@19170000 {
			compatible = "ikanos,vx180-pci";
			device_type = "pci";
			reg = <0x19170000 0x100>;
			#address-cells = <3>;
			#size-cells = <2>;
			#interrupt-cells = <1>;
			bus-range = <0x00 0x00>;
			ranges = <0x02000000 0 0x1a000000 0x1a000000 0 0x01000000>;

			wifi@1,0 {
				reg = <0x0800 0 0 0 0>;
				nvmem-cells = <&calibration_5ghz>;
				nvmem-cell-names = "calibration";
			};

			wifi@2,0 {
				reg = <0x1000 0 0 0 0>;
				nvmem-cells = <&calibration_2ghz>;
				nvmem-cell-names = "calibration";
			};
		};
	};
};
